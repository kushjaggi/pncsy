{
  "name": "pncsy",
  "version": "1.0.4",
  "description": "Prompting nahi, coding sikho — structured learning paths + share-ready PDF/HTML from Markdown. CLI: pncsy",
  "type": "module",
  "bin": {
    "pncsy": "bin/pncsy"
  },
  "files": [
    "bin",
    "scripts",
    "!scripts/capture-screenshots.mjs",
    "skill",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pncsy": "node ./scripts/pncsy.mjs",
    "check": "node ./scripts/check.mjs",
    "prepublishOnly": "npm run check",
    "postinstall": "node -e \"console.error('\\npncsy installed. Try: pncsy learn \\\"Kafka\\\" --level advanced\\n')\""
  },
  "keywords": [
    "pncsy",
    "learning-path",
    "roadmap",
    "syllabus",
    "study-plan",
    "markdown",
    "pdf",
    "html",
    "mermaid",
    "documentation",
    "cli",
    "agent",
    "ai-editor",
    "cursor",
    "claude",
    "windsurf",
    "copilot"
  ],
  "author": "kushjaggi <https://github.com/kushjaggi>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@viz-js/viz": "^3.29.0",
    "marked": "^15.0.0",
    "mermaid": "^11.0.0",
    "puppeteer-core": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kushjaggi/pncsy.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/kushjaggi/pncsy/issues"
  },
  "homepage": "https://github.com/kushjaggi/pncsy#readme"
}
