{
  "name": "inkship",
  "version": "1.0.0",
  "description": "Ship Markdown as share-ready PDF/HTML — auto polish AI dumps, cover, TOC, Mermaid. One command.",
  "type": "module",
  "bin": {
    "inkship": "./bin/inkship"
  },
  "files": [
    "bin",
    "scripts",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "inkship": "node ./scripts/inkship.mjs",
    "postinstall": "node -e \"console.error('inkship ready. Try: inkship README.md --open')\""
  },
  "keywords": [
    "markdown",
    "pdf",
    "html",
    "mermaid",
    "documentation",
    "cli",
    "ai-docs",
    "export"
  ],
  "author": "Kush",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "mermaid": "^11.0.0",
    "puppeteer-core": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kushjaggi/inkship.git"
  },
  "bugs": {
    "url": "https://github.com/kushjaggi/inkship/issues"
  },
  "homepage": "https://github.com/kushjaggi/inkship#readme"
}
