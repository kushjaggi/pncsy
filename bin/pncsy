#!/usr/bin/env bash
# prompting-nahi-coding-sikho-yojna (pncsy)
# Structured learning paths + share-ready docs from Markdown.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$ROOT/scripts/pncsy.mjs"

if [[ ! -f "$SCRIPT" ]]; then
  echo "pncsy: missing $SCRIPT" >&2
  exit 1
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: pncsy <file.md|dir> [options]" >&2
  echo "       pncsy learn \"<topic>\" [--level x] [--depth y]" >&2
  echo "" >&2
  echo "  pncsy learn \"LangGraph\" --level advanced --depth deep" >&2
  echo "  pncsy notes.md" >&2
  echo "  pncsy guide.md --pack --open" >&2
  echo "  pncsy docs/ --pdf" >&2
  echo "" >&2
  exec node "$SCRIPT" --help
fi

exec node "$SCRIPT" "$@"
