#!/usr/bin/env bash
# pncsy — bash by default; Node only via explicit "pncsy node …"
set -euo pipefail

if [[ -n "${PNCSY_HOME:-}" ]]; then
  ROOT="$PNCSY_HOME"
else
  SOURCE="${BASH_SOURCE[0]:-$0}"
  while [[ -h "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
fi

die() { echo "pncsy: $*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
pncsy — scaffold, check, and ship durable docs

No Node required:
  pncsy learn "<topic>" [--level x] [--depth y]
  pncsy check <file.md>    verify a filled doc kept its shape
  pncsy setup              show install status

Project docs (scaffold + fill prompt, same check contract):
  pncsy adr "<decision>"       what was chosen, and what lost
  pncsy arch ["<system>"]      components, boundaries, invariants
  pncsy flow "<path>"          execution trace, entry to exit
  pncsy constraints            what must never change
  pncsy bug "<symptom>"        root cause, blast radius, proof
  pncsy handover ["<label>"]   done, in flight, single next step

Node required (PDF, HTML, Mermaid, custom config):
  pncsy node <file.md> [--pack] [--open]
  pncsy node learn "<topic>" [--config file] [--init-config]
  pncsy setup --node       fetch Node deps (one-time)

Examples:
  pncsy learn "OmniVoice fine-tuning" --level advanced --depth deep
  pncsy adr "Use Postgres over DynamoDB"
  pncsy check omnivoice-fine-tuning-path.md --strict
  pncsy node omnivoice-fine-tuning-path.md --pack --open
EOF
  exit "${1:-1}"
}

has_node() {
  local bin="${PNCSY_NODE:-node}"
  command -v "$bin" >/dev/null 2>&1 || [[ -x "$bin" ]]
}

node_major_ok() {
  local bin="${PNCSY_NODE:-node}"
  local major
  major="$("$bin" -e 'process.stdout.write(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)"
  [[ "${major:-0}" -ge "${PNCSY_NODE_MIN:-18}" ]]
}

node_deps_ready() {
  [[ -f "$ROOT/node_modules/marked/package.json" ]] &&
    [[ -f "$ROOT/node_modules/mermaid/package.json" ]] &&
    [[ -f "$ROOT/node_modules/puppeteer-core/package.json" ]] &&
    [[ -f "$ROOT/node_modules/@viz-js/viz/package.json" ]]
}

run_node() {
  local script="$ROOT/scripts/pncsy.mjs"
  [[ -f "$script" ]] || die "missing $script"
  has_node || die "Node ${PNCSY_NODE_MIN:-18}+ required for this command. Install Node, then: pncsy setup --node"
  node_major_ok || die "Node ${PNCSY_NODE_MIN:-18}+ required (found: $(${PNCSY_NODE:-node} -v 2>/dev/null || echo none))"
  local bin="${PNCSY_NODE:-node}"
  exec "$bin" "$script" "$@"
}

cmd_setup() {
  [[ $# -le 1 ]] || die "setup accepts only --node"
  if [[ "${1:-}" == "--node" ]]; then
    has_node || die "Node not found — install from https://nodejs.org first"
    node_major_ok || die "Node ${PNCSY_NODE_MIN:-18}+ required"
    if node_deps_ready; then
      echo "✓ node deps already present in $ROOT"
      exit 0
    fi
    echo "→ fetching node deps into $ROOT …"
    local bin="${PNCSY_NODE:-node}"
    if ! "$bin" "$ROOT/scripts/fetch-deps.mjs"; then
      if command -v npm >/dev/null; then
        (cd "$ROOT" && npm install --omit=dev --no-fund --no-audit)
      else
        die "could not fetch deps — run again or check network (curl + tar required)"
      fi
    fi
    echo "✓ node stack ready — try: pncsy node file.md --pack"
    exit 0
  fi
  [[ $# -eq 0 ]] || die "unknown setup option: $1 (use: pncsy setup --node)"

  echo "pncsy @ $ROOT"
  echo "  learn (bash): ready"
  if node_deps_ready; then
    echo "  node stack:   ready"
  elif has_node; then
    echo "  node stack:   not installed — run: pncsy setup --node"
  else
    echo "  node stack:   needs Node — install Node, then: pncsy setup --node"
  fi
}

[[ $# -lt 1 ]] && usage 0

case "$1" in
  -h|--help) usage 0 ;;
  learn)
    shift
    exec "$ROOT/scripts/learn.sh" "$@"
    ;;
  adr|arch|flow|constraints|bug|handover)
    exec "$ROOT/scripts/doc.sh" "$@"
    ;;
  check)
    shift
    exec "$ROOT/scripts/check-path.sh" "$@"
    ;;
  node)
    shift
    [[ $# -lt 1 ]] && usage
    run_node "$@"
    ;;
  setup)
    shift
    cmd_setup "$@"
    ;;
  *)
    die "unknown command: $1
Use pncsy --help for learning paths, project records, checks, and PDF/HTML shipping"
    ;;
esac
